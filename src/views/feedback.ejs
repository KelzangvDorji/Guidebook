<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <div class="card card-narrow">
      <span class="tag">Query &amp; Feedback</span>
      <h2>Talk to us</h2>
      <p>Questions, bugs, or ideas &mdash; send a message and we'll get back to you.</p>
      <% if (sent) { %><div class="alert alert-success">Thank you &mdash; your message has been sent.</div><% } %>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="post" action="/feedback">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="field">
          <label for="email">Your email</label>
          <input id="email" name="email" type="email" required value="<%= user && user.email ? user.email : '' %>" />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Send Message</button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
