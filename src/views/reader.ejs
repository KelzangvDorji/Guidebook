<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 3L28 14.5V29H4V14.5L16 3Z' fill='none' stroke='%237A1E2B' stroke-width='2'/%3E%3Ccircle cx='16' cy='17' r='4' fill='none' stroke='%23B8863B' stroke-width='1.6'/%3E%3C/svg%3E" />
  <link rel="stylesheet" href="/public/css/style.css?v=<%= v %>" />
</head>
<body class="reader-page">
  <div class="reader-topbar">
    <div class="rt-title"><% if (mode === 'preview') { %>Preview &middot; <% } %><%= book.title %><span>by <%= book.author_name %></span></div>
    <a href="<%= mode === 'preview' ? '/books/' + book.id : '/my-library' %>" class="btn btn-outline-light btn-sm">&larr; <%= mode === 'preview' ? 'Back to Book' : 'My Library' %></a>
  </div>

  <% if (mode === 'preview') { %>
    <p class="reader-hint" style="margin-top:18px;">
      This is a free preview of the first <%= book.page_count %> pages, generated by the server so the rest of the book is
      never sent to your browser. Buy the book to unlock the full text in the protected reader.
    </p>
  <% } else { %>
    <p class="reader-hint" style="margin-top:18px;">
      This viewer is watermarked to your account and blocks normal download/print controls. It cannot guarantee screenshots
      are impossible &mdash; operating-system tools, another camera, or screen recording can still capture the screen.
      We detect common in-browser capture signals and obscure the page when they're seen.
    </p>
  <% } %>

  <div id="readerRoot" class="reader-canvas-wrap">
    <div class="reader-loading">Loading&hellip;</div>
  </div>

  <div id="readerShield" class="reader-shield">
    <div>
      <h3 style="color:#f1e8d6;">Content hidden</h3>
      <p style="color:#b6a88f; max-width: 420px;">A possible screen capture action was detected. This page is hidden as a precaution and will reappear shortly.</p>
    </div>
  </div>

  <script type="module" src="/public/js/reader.js?v=<%= v %>" id="readerScript"
    data-book-id="<%= book.id %>"
    data-mode="<%= mode %>"
    data-csrf="<%= csrfToken %>"
    data-name="<%= mode === 'full' ? user.name : '' %>"
    data-contact="<%= mode === 'full' ? (user.email || user.phone) : '' %>"></script>
</body>
</html>
