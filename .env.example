# Copy this file to .env and fill in real values before running in production.

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Security secrets - generate long random strings for production
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=dev-only-change-me-auth-secret-please-rotate
CSRF_SECRET=dev-only-change-me-csrf-secret-please-rotate

# Google Sign-In (OAuth 2.0). Leave blank to disable - the "Continue with
# Google" button is hidden automatically when these aren't set.
# 1. Create a project + OAuth client at https://console.cloud.google.com/apis/credentials
# 2. Application type: "Web application"
# 3. Authorized redirect URI: <BASE_URL>/auth/google/callback
#    e.g. http://localhost:3000/auth/google/callback for local development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Database (Turso - hosted libSQL, async SQLite-compatible)
# 1. Create a database at https://turso.tech
# 2. Copy the database URL (libsql://...) and create an auth token for it
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Object storage (any S3-compatible provider - Backblaze B2, Filebase, etc).
# PDFs are always private, streamed through the server (src/routes/reader.js).
# Covers are non-sensitive but are ALSO proxied through the server now
# (GET /covers/:filename in src/routes/pages.js) rather than served from a
# public bucket URL directly - this lets everything live in a single bucket,
# which matters on providers whose free tier caps you at one bucket (e.g.
# Filebase). If your provider supports multiple free buckets, you can still
# split PDFs and covers into two by setting STORAGE_COVERS_BUCKET to a
# different name - the app works either way since both are only ever
# accessed server-side.
# 1. Create a bucket (e.g. bhutan-reads) at your provider
# 2. Create an access key with read/write access to it
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_COVERS_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# SMTP (Query & Feedback emails). If left blank, emails are logged to the
# console instead of being sent (safe local development fallback).
# For Gmail: SMTP_PASS must be a 16-character *App Password*, not your normal
# Gmail password - generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the account first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bhutan Reads <no-reply@bhutanreads.example>"
FEEDBACK_TO_EMAIL=kelzangdorji461@gmail.com

# Payments - development/test flow is used automatically when these are blank.
# Swap in a real provider's server-side keys later; nothing in the frontend
# needs to change since the payment modal only talks to /api/payments/*.
PAYMENT_PROVIDER=dev-test
PAYMENT_SECRET_KEY=

# Optional: one-way Google Sheets mirror of new users/books/purchases/
# feedback/author-requests, appended as they happen. SQLite remains the real
# source of truth; this is purely a human-readable export. Leave blank to
# disable. See GUIDE.md section 14 for exact setup steps.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
